{
  "jbit": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs PostInvocation",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook.mjs PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs PreInvocation",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook.mjs PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs SessionStart",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs Stop",
        "timeout": 30
      }
    ]
  }
}
