{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" agentStop",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" postToolUse",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" preToolUse",
        "timeoutSec": 30
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" sessionStart",
        "timeoutSec": 30
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" userPromptTransformed",
        "timeoutSec": 30
      }
    ]
  }
}
